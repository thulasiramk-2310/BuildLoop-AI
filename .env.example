# Copy to .env (never commit .env). The key stays in the backend process only.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_REASONING_MODEL=muse-spark-1.3
META_SEGMENTATION_MODEL=sam-3.1

# Optional alternative reasoning backend: Muse Spark OPEN served by an inference partner (OpenAI-compatible).
# Explicit opt-in only; outputs are labelled "open-weight", never "Muse Spark API". SAM 3.1 still uses the Meta Model API.
REASONING_BACKEND=meta_api
# sam = SAM 3.1 via Meta Model API (masks). vlm = open-weight multimodal model inventory (no masks, not SAM).
PERCEPTION_BACKEND=sam
# open-weight preset: auto | huggingface | baseten | custom (auto prefers Baseten, then Hugging Face)
OPEN_WEIGHT_PROVIDER=auto
# Baseten Model APIs key (slug meta-models/muse-spark-open, https://inference.baseten.co/v1). Create it yourself; never paste it in chat.
BASETEN_API_KEY=
# Hugging Face token for Inference Providers (needs account credits; HTTP 402 = no credits).
HF_TOKEN=
OPEN_WEIGHT_BASE_URL=
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_MODEL=
# Example (Hugging Face Inference Providers, token created by you with the "Make calls to Inference Providers" permission):
#   OPEN_WEIGHT_BASE_URL=https://router.huggingface.co/v1
#   OPEN_WEIGHT_MODEL=meta-models/Muse-Glimmer-30B
# Optional price list for cost ESTIMATES (USD per 1M tokens):
OPEN_WEIGHT_PRICE_IN_PER_M=
OPEN_WEIGHT_PRICE_OUT_PER_M=

# Optional limits
META_MAX_REQUESTS=200
META_MIN_INTERVAL_S=1.0
META_TIMEOUT_S=60
META_RETRIES=3
